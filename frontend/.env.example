# Logr Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# Base URL of the Django backend API.
# During next dev, Next.js proxies /api/v1/* to this URL to avoid browser CORS.
# Restart next dev after changing this value. Leave off the /api/v1 suffix.
# Development: http://localhost:8000
# Production: https://api.logr.oau.edu.ng (example — confirm with backend partner)
NEXT_PUBLIC_API_URL=http://localhost:8000
